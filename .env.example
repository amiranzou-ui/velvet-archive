# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  VELVET ARCHIVE — Environment Configuration
#  Copy this to .env and fill in your values
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Your Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin Telegram user IDs (comma-separated, no spaces)
# These users can upload songs and manage the archive
ADMIN_IDS=123456789,987654321

# Optional: Telegram channel username (without @) for channel integration
# Leave empty if you don't use a channel
CHANNEL_ID=

# Database file path (relative to project root)
DATABASE_PATH=database/velvet.db

# Max songs per page in search results
PAGE_SIZE=5

# Bot display name (shown in captions and menus)
BOT_NAME=Velvet Archive
